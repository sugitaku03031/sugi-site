---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	decodeSlug,
} from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { getLang, useT } from "../../i18n/ui";

const t = useT(getLang(Astro.request));

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("tag", {
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.rewrite("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}
---

<Base title={t.taggedPosts(term.label)} description={t.taggedPosts(term.label)}>
	<h1>{t.tagPrefix}: {term.label}</h1>

	{
		posts.length === 0 ? (
			<p>{t.noPostsTag}</p>
		) : (
			<ul>
				{posts.map((post) => (
					<li>
						<a href={`/posts/${post.id}`}>
							{post.data.featured_image && (
								<div {...post.edit.featured_image}><Image image={post.data.featured_image} /></div>
							)}
							<h2 {...post.edit.title}>{post.data.title}</h2>
						</a>
						{post.data.excerpt && <p {...post.edit.excerpt}>{post.data.excerpt}</p>}
					</li>
				))}
			</ul>
		)
	}
	<nav aria-label={t.pagination}>
		{cursor && <a href={`/tag/${term.slug}`}>{t.firstPage}</a>}
		{
			nextCursor && (
				<a href={`/tag/${term.slug}?cursor=${encodeURIComponent(nextCursor)}`}>
					{t.nextPage}
				</a>
			)
		}
	</nav>
</Base>
