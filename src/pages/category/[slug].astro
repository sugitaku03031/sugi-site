---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	decodeSlug,
} from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { getLang, localizeTerm, useT } from "../../i18n/ui";

const lang = getLang(Astro.request);
const t = useT(lang);

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("category", {
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.rewrite("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}
const label = localizeTerm(lang, term.slug, term.label);
---

<Base title={t.categoryPosts(label)} description={t.categoryPosts(label)}>
	<h1>{label}</h1>

	{
		posts.length === 0 ? (
			<p>{t.noPostsCategory}</p>
		) : (
			<ul>
				{posts.map((post) => (
					<li>
						<a href={`/posts/${post.id}`}>
							{post.data.featured_image && (
								<div {...post.edit.featured_image}><Image image={post.data.featured_image} /></div>
							)}
							<h2 {...post.edit.title}>{post.data.title}</h2>
						</a>
						{post.data.excerpt && <p {...post.edit.excerpt}>{post.data.excerpt}</p>}
					</li>
				))}
			</ul>
		)
	}
	<nav aria-label={t.pagination}>
		{cursor && <a href={`/category/${term.slug}`}>{t.firstPage}</a>}
		{
			nextCursor && (
				<a
					href={`/category/${term.slug}?cursor=${encodeURIComponent(nextCursor)}`}
				>
					{t.nextPage}
				</a>
			)
		}
	</nav>
</Base>
