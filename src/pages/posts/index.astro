---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { getLang, useT } from "../../i18n/ui";

const t = useT(getLang(Astro.request));

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Single batched query for tags across every post, instead of calling
// getEntryTerms() per post (which would be N round-trips).
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);
const postsWithTags = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
}));
---

<Base title={t.posts}>
	<h1>{t.posts}</h1>

	{
		postsWithTags.length === 0 ? (
			<p>{t.noPosts}</p>
		) : (
			<ul>
				{postsWithTags.map(({ post, tags }) => (
					<li>
						<a href={`/posts/${post.id}`}>
							{post.data.featured_image && (
								<div {...post.edit.featured_image}><Image image={post.data.featured_image} /></div>
							)}
							<h2 {...post.edit.title}>{post.data.title}</h2>
						</a>
						{post.data.excerpt && <p {...post.edit.excerpt}>{post.data.excerpt}</p>}
						{tags.length > 0 && (
							<div>
								{tags.map((t) => (
									<a href={`/tag/${t.slug}`}>{t.label}</a>
								))}
							</div>
						)}
					</li>
				))}
			</ul>
		)
	}
	<nav aria-label={t.pagination}>
		{cursor && <a href="/posts">{t.firstPage}</a>}
		{
			nextCursor && (
				<a href={`/posts?cursor=${encodeURIComponent(nextCursor)}`}>
					{t.nextPage}
				</a>
			)
		}
	</nav>
</Base>
